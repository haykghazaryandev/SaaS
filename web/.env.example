# Bookball — copy to .env and run `php artisan key:generate`. See INSTALL.md.
APP_NAME=ZoneSpot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# languages: hy (default), ru, en; all times are shown in Yerevan time, the database stores UTC
APP_LOCALE=hy
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_DISPLAY_TIMEZONE=Asia/Yerevan

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required (the no-double-booking rule uses a Postgres exclusion constraint + btree_gist)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bookball
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# email login codes: log in development; a free provider in production (Resend, Brevo) with MAIL_* settings
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@zonespot.com"
MAIL_FROM_NAME="ZoneSpot"

# Option 1, Gmail (for testing; about 500 emails a day, the sender must be that Gmail address, may land in spam).
# Needs 2-Step Verification on the Google account, then Google Account → Security → App passwords (16 letters, no spaces).
# Port 587 turns on encryption by itself. If emails never arrive with a timeout, the host blocks SMTP.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD=your16letterapppassword
# MAIL_FROM_ADDRESS="yourname@gmail.com"

# Option 2, Mailtrap Email Sending (real delivery; the sender must be on a domain verified in Mailtrap → Sending Domains).
# The username is the word "api", the password is the API token (Mailtrap → Sending Domains → SMTP/API Settings).
# MAIL_MAILER=smtp
# MAIL_HOST=live.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=api
# MAIL_PASSWORD=your-mailtrap-api-token
# MAIL_FROM_ADDRESS="noreply@your-verified-domain.com"

# Option 3, Mailtrap Email Testing (sandbox): for a developer's computer and staging. Every email lands in the Mailtrap
# inbox, nobody real gets it. Username and password: Mailtrap → Email Testing → the inbox → SMTP Settings.
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your-inbox-username
# MAIL_PASSWORD=your-inbox-password

# Real time (chat, notifications, live owner schedule): Laravel Reverb.
# Any values work locally; generate new ones for production (php artisan reverb:install).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100001
REVERB_APP_KEY=bookball-local-key
REVERB_APP_SECRET=bookball-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# The seeded admin (you). Set your own phone before `php artisan migrate:fresh --seed`.
ADMIN_PHONE=+37499000000

# Telegram
# Main login is FREE: "Log in with Telegram" (our bot confirms the phone) + email codes (MAIL_* below).
# The old phone + code: OTP_DRIVER=log shows the code in development; "gateway" = paid Telegram Gateway (~$0.01/code, not used)
OTP_DRIVER=log
TELEGRAM_GATEWAY_TOKEN=
# the team's bot @BookballAmBot (shared on purpose, private repo). Only ONE computer can run `php artisan telegram:poll` at a time.
# empty = bot messages are only written to the log
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BookballAmBot
# Mini App short name from BotFather (/newapp), e.g. "app": invite links become t.me/<bot>/app?startapp=…
TELEGRAM_APP_NAME=
# random string (A-Z a-z 0-9 _ -), then run: php artisan telegram:set-webhook
TELEGRAM_WEBHOOK_SECRET=

# Web Push ("Notifications on this device" in Profile); empty = push off, the switch is hidden.
# Generate once per environment: php artisan webpush:vapid --show (prints both keys). Changing them drops every device.
# Push needs https (or http://localhost). SUBJECT: mailto:you@example.com or the site URL (default APP_URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
