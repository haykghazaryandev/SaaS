# Staging settings kept in the repo for now (loaded automatically when APP_ENV=staging).
# Variables set in Railway always win over this file; move these there later and delete the file.
# Only staging bot settings belong here. Never create a .env.production like this.

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BookballAmBot
# random, letters/digits/_/- only, e.g. from: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GATEWAY_TOKEN=
OTP_DRIVER=log
